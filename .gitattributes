# Normalise text files to LF in the repository.
* text=auto

# Shell scripts must keep LF endings or they fail on Linux/macOS (including CI).
gradlew text eol=lf
*.sh    text eol=lf

# Windows batch files expect CRLF.
*.bat   text eol=crlf

# Binary files.
*.jar   binary
*.png   binary
*.jks   binary
